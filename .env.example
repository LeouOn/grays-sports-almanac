# ── LLM Provider API Keys (set at least one) ────────────────
# Google Gemini — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_key_here

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_key_here

# Zhipu AI (智谱) International — https://open.bigmodel.cn/
ZHIPU_API_KEY=your_key_here

# MiniMax International — https://platform.minimax.io/
MINIMAX_API_KEY=your_key_here

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=your_key_here

# ── Optional: override default model per provider ────────────
# GOOGLE_MODEL=gemini-2.0-flash
# DEEPSEEK_MODEL=deepseek-chat
# ZHIPU_MODEL=glm-4-flash
# MINIMAX_MODEL=MiniMax-Text-01
# OPENROUTER_MODEL=google/gemini-2.0-flash-001

# ── Server ───────────────────────────────────────────────────
PORT=3001

# ── API Security (optional) ──────────────────────────────────
# Set this to require X-API-Key header on all /api/v1/ endpoints.
# Leave unset for open access on localhost.
# API_KEY=your_secret_api_key
